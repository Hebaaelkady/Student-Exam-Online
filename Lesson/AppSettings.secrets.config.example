<!-- هذا ملف توضيحي للمفاتيح - استبدل القيم بقيمك الحقيقية في AppSettings.secrets.config محلياً -->
<appSettings>
	<add key="JwtSecretKey" value="REPLACE_WITH_YOUR_STRONG_SECRET_KEY_AT_LEAST_32_CHARACTERS" />
	<add key="AdminUserNames" value="admin1,admin2" />
	<add key="EncryptionMasterKey" value="REPLACE_WITH_YOUR_AES_256_KEY_HERE" />
</appSettings>
