﻿<!DOCTYPE html>
@using System.Security.Claims
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - نظام الاختبارات</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
        }

        .btn {
            border-radius: 5px;
        }

        .table th {
            background-color: #f1f5f9;
            font-weight: 600;
        }

        /* تخصيص للغة العربية */
        body[dir="rtl"] {
            text-align: right;
        }

        /* ألوان خاصة */
        .bg-custom-1 {
            background-color: #2c3e50;
        }

        .text-custom-1 {
            color: #2c3e50;
        }
    </style>
</head>
<body dir="rtl">

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
             
            <a class="navbar-brand" href="@Url.Action("Main", "Exams")">
                <i class="fas fa-graduation-cap"></i> نظام الاختبارات
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto" id="mainMenu">
                </ul>

                <div class="navbar-text">
                    <i class="fas fa-calendar-alt"></i> @DateTime.Now.ToString("yyyy/MM/dd")
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container-fluid">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-3 bg-dark text-white">
        <div class="container text-center">
            <span>
                <i class="fas fa-copyright"></i> @DateTime.Now.Year - نظام إدارة الاختبارات
            </span>
            @*<span class="ms-3">
                <i class="fas fa-phone"></i> الدعم الفني: 0123456789
            </span>*@
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // إظهار/إخفاء الرسائل
        $(document).ready(function () {
            setTimeout(function () {
                $('.alert').fadeOut('slow');
            }, 5000);

            // تفعيل tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
    <script>
        $(window).on("load", function () {

            //e.preventDefault();
            var requrl = '/StudentReport/GetNotfication';


            $.ajax({
                type: "post",
                dataType: 'json',
                cashe: true,
                url: requrl,
                data: {},
                success: function (data) {
                    $('#not').append(data);



                },
                error: function (failure) {
                    alert(failure.responseText);
                }
            });
        });
    </script>
    <script>
        $(window).on("load", function () {

            $.ajax({
                type: "post",
                dataType: 'json',
                url: '/StudentReport/GetNotfication',
                success: function (data) {
        
                    if (data.isSupport == true) {
                        // Support
                        $('#mainMenu').html(`
                               <li class="nav-item">
                                   <a class="nav-link" href="/student/StudentReport/OpenTickets">
                                       <i class="fas fa-envelope"></i> الشكاوى المفتوحة
                                   </a>
                               </li>
                               <li class="nav-item">
                                   <a class="nav-link" href="/student/StudentReport/Index">
                                       <i class="fas fa-search"></i> البحث والتقارير
                                   </a>
                               </li>
                                <li class="nav-item">
     <a class="nav-link" href="/student/StudentReport/ArchivedTickets">
         <i class="fas fa-search"></i> التذاكر المؤرشفة
     </a>
 </li>
                               <li class="nav-item">
    @using (Html.BeginForm("LogOff", "../Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {

        @Html.AntiForgeryToken()
        <a data-toggle="dropdown" class="nav-link Signout" href="javascript:document.getElementById('logoutForm').submit()">      تسجيل الخروج</a>

    }
</li>
                           `);
                    }
                    else {
                        // Student
                        $('#mainMenu').html(`
                               <li class="nav-item">
      <a class="nav-link" href="/StudentReport/MyReport">
          <i class="fas fa-file-alt"></i> تقريري
      </a>
  </li>  <li class="nav-item">
      <a class="nav-link" href="/Student/Exams/Main">
          <i class="fas fa-file-alt"></i> الامتحان
      </a>
  </li><li class="nav-item">
    @using (Html.BeginForm("LogOff", "../Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {

        @Html.AntiForgeryToken()
        <a data-toggle="dropdown" class="nav-link Signout" href="javascript:document.getElementById('logoutForm').submit()">      تسجيل الخروج</a>

    }
</li>
                           `);
                    }
                },
                error: function () {
                    alert("حدث خطأ");
                }
            });

        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>