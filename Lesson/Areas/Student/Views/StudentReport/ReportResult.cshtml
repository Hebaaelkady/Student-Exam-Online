                        setTimeout(function () {
                            location.reload();
                        }, 3000);
                    } else {
                        showToast('error', response.message || 'حدث خطأ أثناء حفظ البيانات');
                        $('#saveStudentBtn').prop('disabled', false).html('<i class="fas fa-save fa-icon"></i> حفظ التغييرات');
                    }
                },
                error: function (xhr, status, error) {
                    console.log('خطأ AJAX:', xhr.responseText); // للتشخيص

                    var errorMessage = 'حدث خطأ في الاتصال بالخادم';
                    try {
                        var response = JSON.parse(xhr.responseText);
                        errorMessage = response.message || errorMessage;
                    } catch (e) {
                        errorMessage = xhr.responseText || errorMessage;
                    }

                    showToast('error', errorMessage);
                    $('#saveStudentBtn').prop('disabled', false).html('<i class="fas fa-save fa-icon"></i> حفظ التغييرات');
                }
            });
        });
