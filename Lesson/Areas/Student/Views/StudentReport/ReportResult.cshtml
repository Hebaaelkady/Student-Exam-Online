@section Scripts {
    <script>
        // جلب بيانات الطالب عند فتح المودال
        function loadStudentData(studentNumber) {
            $('#studentNumber').val(studentNumber);

            $.ajax({
                url: '@Url.Action("GetStudentData", "StudentReport")',
                type: 'GET',
                data: { studentNumber: studentNumber },
                success: function(response) {
                    if (response.success) {
                        $('#studentName').val(response.data.studentName);
                        $('#userName').val(response.data.userName);
                        $('#countryName').val(response.data.countryName);
                        $('#className').val(response.data.className);
                        $('#phoneNumber').val(response.data.phoneNumber);
                        $('#newGroupId').val(response.data.groupId);
                    }
                }
            });
        }

        // دالة لعرض النص الكامل في modal
        function showFullText(element) {
            var fullText = $(element).closest('.question-title').data('full-title');
            $('#modalTextContent').html(fullText);
            $('#fullTextModal').modal('show');
            return false;
        }

        // توسيع/طي جميع الأقسام
        function toggleAllExams() {
            $('.collapse').collapse('toggle');
        }

        // معالجة زر فتح الامتحان
        $(document).on('click', '.open-exam-btn', function() {
            var examId = $(this).data('exam-id');
            var studentNumber = $(this).data('student-number');

            $('#examIdToOpen').val(examId);
            $('#studentNumberToOpen').val(studentNumber);

            // جلب تفاصيل الامتحان
            $.ajax({
