                    if (response.success) {
                        showToast('success', response.message || 'تم تحديث بيانات الطالب بنجاح');
                        // إغلاق المودال بعد تأخير
                        setTimeout(function () {
                            $('#editStudentModal').modal('hide');
                        }, 2000);
