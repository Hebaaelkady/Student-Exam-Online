        // تأكيد فتح الامتحان
        $('#confirmOpenExam').click(function () {
          
            var examId = $('#examIdToOpen').val();
            var studentNumber = $('#studentNumberToOpen').val();

            $('#confirmOpenExam').prop('disabled', true).html('<i class="fas fa-spinner fa-spin fa-icon"></i> جاري الفتح...');
          
            $.ajax({
                url: '@Url.Action("OpenExam", "StudentReport")',
                type: 'POST',
                data: {
                    examId: examId,
                    studentNumber: studentNumber,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showToast('success', 'تم فتح الامتحان بنجاح');
                        $('#openExamModal').modal('hide');
                        // تحديث الصفحة بعد ثانيتين
                        setTimeout(function() {
                            location.reload();
                        }, 2000);
                    } else {
                        showToast('error', response.message || 'حدث خطأ أثناء فتح الامتحان');
                        $('#confirmOpenExam').prop('disabled', false).html('<i class="fas fa-check fa-icon"></i> نعم، افتح الامتحان');
                    }
                },
                error: function() {
                    showToast('error', 'حدث خطأ في الاتصال بالخادم');
                    $('#confirmOpenExam').prop('disabled', false).html('<i class="fas fa-check fa-icon"></i> نعم، افتح الامتحان');
                }
            });
        });

        // دالة لعرض رسائل Toast
        function showToast(type, message) {
            var toastClass = type === 'success' ? 'bg-success' : 'bg-danger';

            var toastHtml = `
                <div class="toast align-items-center text-white ${toastClass} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;

            $('#toastContainer').html(toastHtml);
            var toast = new bootstrap.Toast($('#toastContainer .toast')[0]);
            toast.show();
        }



// فتح المودال وتحميل البيانات
function openEditModal(studentNumber) {
    if (!studentNumber) {
        showToast('error', 'رقم الطالب غير متوفر');
        return;
    }

    // إعادة تعيين النموذج
    $('#editStudentForm')[0].reset();
    $('#studentNumber').val(studentNumber);

    // جلب البيانات من الخادم
    $.ajax({
        url: '@Url.Action("GetStudentFullData", "StudentReport")',
        type: 'GET',
        data: { studentNumber: studentNumber },
        beforeSend: function() {
            $('#saveStudentBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin fa-icon"></i> جاري التحميل...');
        },
        success: function(response) {
            if (response.success && response.data) {
                // تعبئة الحقول الأساسية
                $('#studentName').val(response.data.studentName || '');
                $('#userName').val(response.data.userName || '');
                $('#email').val(response.data.email || '');
                $('#phoneNumber').val(response.data.phoneNumber || '');
                $('#countryName').val(response.data.countryName || '');
                $('#instName').val(response.data.instName || '');

                // تعبئة القوائم المنسدلة
                if (response.data.rowId) {
                    $('#rowId').val(response.data.rowId.toString());
                }
                if (response.data.stageId) {
                    $('#stageId').val(response.data.stageId.toString());
                }
                if (response.data.mazhabId) {
                    $('#mazhabId').val(response.data.mazhabId.toString());
                }
                if (response.data.sho3baId) {
                    $('#sho3baId').val(response.data.sho3baId.toString());
                }
                if (response.data.instTypeId) {
                    $('#instTypeId').val(response.data.instTypeId.toString());
                }
                if (response.data.groupId) {
                    $('#newGroupId').val(response.data.groupId.toString());
                }

                // فتح المودال
                var modal = new bootstrap.Modal(document.getElementById('editStudentModal'));
                modal.show();
            } else {
                showToast('error', response.message || 'حدث خطأ في جلب بيانات الطالب');
            }
        },
        error: function(xhr, status, error) {
            showToast('error', 'حدث خطأ في الاتصال بالخادم: ' + error);
        },
        complete: function() {
            $('#saveStudentBtn').prop('disabled', false).html('<i class="fas fa-save fa-icon"></i> حفظ التغييرات');
        }
    });
}

 

