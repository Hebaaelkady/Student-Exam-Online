﻿@model List<Lesson.Models.StudentUnansweredReport>
@{
    ViewBag.Title = "نتائج تقرير الأسئلة غير المجابة";
    Layout = "~/Areas/Student/Views/Shared/_LayoutAdmin.cshtml";

    // الحصول على تقرير الامتحانات
    var studentExamsReport = ViewBag.StudentExamsReport as List<Lesson.Models.StudentExamReport>;
    if (studentExamsReport == null)
    {
        studentExamsReport = new List<Lesson.Models.StudentExamReport>();
    }

    // استخدام ViewBag.Student
    var student = ViewBag.Student as Lesson.Models.AspNetUser;

    // الحصول على أول طالب من النموذج إذا كان موجوداً
    var firstStudentFromModel = Model.FirstOrDefault();

    // الحصول على البيانات من قاعدة البيانات
    var groups = ViewBag.Groups as List<SelectListItem>;
    if (groups == null)
    {
        groups = new List<SelectListItem>();
    }

    var mazhabs = ViewBag.Mazhabs as List<SelectListItem>;
    if (mazhabs == null)
    {
        mazhabs = new List<SelectListItem>();
    }

    var sho3bas = ViewBag.Sho3bas as List<SelectListItem>;
    if (sho3bas == null)
    {
        sho3bas = new List<SelectListItem>();
    }

    var instTypes = ViewBag.InstTypes as List<SelectListItem>;
    if (instTypes == null)
    {
        instTypes = new List<SelectListItem>();
    }

    var rows = ViewBag.Rows as List<SelectListItem>;
    if (rows == null)
    {
        rows = new List<SelectListItem>();
    }

    var stages = ViewBag.Stages as List<SelectListItem>;
    if (stages == null)
    {
        stages = new List<SelectListItem>();
    }

    // تعريف المتغيرات
    int? studentNumber = null;
    string studentName = "";
    string userName = "";
    string countryName = "";
    string instName = "";
    string phoneNumber = "";
    string email = "";
    int? rowId = null;
    int? stageId = null;
    int? mazhabId = null;
    int? sho3baId = null;
    int? instTypeId = null;
    byte? groupId = null;

    // تعبئة البيانات من الطالب
    if (student != null)
    {
        studentNumber = student.StudentNumber;
        studentName = student.StudentName != null ? student.StudentName : "";
        userName = student.UserName != null ? student.UserName : "";
        countryName = student.CountryName != null ? student.CountryName : "";
        instName = student.InstName != null ? student.InstName : "";
        phoneNumber = student.PhoneNumber != null ? student.PhoneNumber : "";
        email = student.Email != null ? student.Email : "";
        rowId = student.RowID;
        stageId = student.StageID;
        mazhabId = student.MazhabID;
        sho3baId = student.Sho3baID;
        instTypeId = student.InstTypeID;
        groupId = student.GroupID;
    }
    else if (firstStudentFromModel != null)
    {
        studentNumber = firstStudentFromModel.StudentNumber;
        studentName = firstStudentFromModel.StudentName != null ? firstStudentFromModel.StudentName : "";
        userName = firstStudentFromModel.UserName != null ? firstStudentFromModel.UserName : "";
        countryName = firstStudentFromModel.CountryName != null ? firstStudentFromModel.CountryName : "";
    }
}
<style>
    /* تحسين المودال */
    .modal-lg {
        max-width: 900px !important;
    }

    /* ارتفاع متجاوب للمودال */
    .modal-dialog {
        max-height: 85vh;
        margin: 1.75rem auto;
    }

    /* محتوى المودال مع scroll */
    .modal-content {
        max-height: 85vh;
        display: flex;
        flex-direction: column;
    }

    .modal-body {
        overflow-y: auto;
        flex: 1;
        max-height: 60vh;
        padding: 20px;
    }

        /* تحسين مظهر الـ Scroll */
        .modal-body::-webkit-scrollbar {
            width: 8px;
        }

        .modal-body::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .modal-body::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }

            .modal-body::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

    /* تحسين الحقول */
    .form-group {
        margin-bottom: 1rem;
    }

    .input-group {
        margin-bottom: 0.5rem;
    }

    /* عناوين الحقول */
    .form-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #495057;
        display: block;
    }

    /* تحسين الأسطر */
    .row {
        margin-bottom: 0.5rem;
    }

    /* حقل مطلوب */
    .required {
        color: #dc3545;
        font-weight: bold;
    }

    /* تحسين الأزرار */
    .modal-footer {
        padding: 1rem;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
        flex-shrink: 0;
    }

    /* تحسين القوائم المنسدلة */
    select.form-control {
        height: 38px;
        padding: 0.375rem 0.75rem;
    }

    /* تحسين الإختيار في القوائم */
    option:checked {
        background-color: #007bff;
        color: white;
    }

    /* التلميحات */
    .form-text {
        font-size: 0.85rem;
        color: #6c757d;
    }
</style>
<style>
    /* تأكد من ظهور المودال */
    .modal {
        display: none;
        position: fixed;
        z-index: 1050;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        outline: 0;
        background-color: rgba(0,0,0,0.5);
    }

        .modal.show {
            display: block;
        }

    .modal-dialog {
        position: relative;
        width: auto;
        margin: 10px;
        pointer-events: none;
    }

    .modal-content {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        pointer-events: auto;
        background-color: #fff;
        background-clip: padding-box;
        border: 1px solid rgba(0,0,0,.2);
        border-radius: 0.3rem;
        outline: 0;
    }

    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1040;
        width: 100vw;
        height: 100vh;
        background-color: #000;
    }

        .modal-backdrop.show {
            opacity: 0.5;
        }
</style>
<style>
    .alert-info, .alert-success, .alert-danger, .alert-warning {
        display: block !important
    }

    .table th {
        color: #000;
        background-color: #f8f9fa !important;
    }

    /* أنماط للأزرار */
    .action-buttons .btn {
        margin: 2px;
        min-width: 120px;
        font-size: 0.85rem;
    }

    .exam-actions {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .student-actions {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
    }

    /* كارت الطالب مع موقف نسبي */
    .student-card {
        position: relative;
        padding-top: 60px;
    }

    /* تنسيق البطاقات */
    .card-header {
        background: linear-gradient(45deg, #2c3e50, #34495e) !important;
    }

    .card {
        border: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    /* تنسيق الجداول */
    .table-striped tbody tr:nth-of-type(odd) {
        background-color: rgba(0, 0, 0, 0.02);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }

    /* تنسيق الباجات */
    .badge {
        font-size: 0.85em;
        padding: 5px 10px;
        border-radius: 20px;
    }

    /* تنسيق الأكورديون */
    .accordion-button:not(.collapsed) {
        background-color: #e9ecef;
        color: #000;
        box-shadow: none;
    }

    .accordion-button:focus {
        box-shadow: none;
        border-color: rgba(0,0,0,.125);
    }

    /* تنسيق النماذج */
    .form-control:focus {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }

    /* تنسيق المودال */
    .modal-header {
        background: linear-gradient(45deg, #007bff, #0056b3) !important;
    }

    /* تصميم متجاوب */


    /* ألوان الحالة */
    .status-active {
        color: #28a745;
    }

    .status-inactive {
        color: #6c757d;
    }

    .status-pending {
        color: #ffc107;
    }

    .status-finished {
        color: #dc3545;
    }

    /* تنسيق الأيقونات */
    .fa-icon {
        margin-left: 5px;
    }

    /* تنسيق المدة */
    .duration-badge {
        background-color: #17a2b8;
        color: white;
        padding: 3px 8px;
        border-radius: 10px;
        font-size: 0.8rem;
    }
</style>

<div class="container-fluid mt-4">
    <!-- زر العودة -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-right fa-icon"></i> بحث جديد
                </a>

                <!-- زر تعديل بيانات الطالب (في الأعلى) -->
                <!-- زر تعديل بيانات الطالب (في الأعلى) -->
                @if (student != null || firstStudentFromModel != null)
                {
                    <div>
                        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#editStudentModal"
                                data-student-number="@studentNumber">
                            <i class="fas fa-user-edit fa-icon"></i> تعديل بيانات الطالب
                        </button>
                        
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- شريط الإحصائيات -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                     الاسم
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@studentName</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                             رقم الجلوس
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@studentNumber</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                               اسم المعهد
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@instName</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-question-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                               مجموعة
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@groupId</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- تقرير امتحانات الطالب -->
    @if (studentExamsReport.Any())
    {
        <div class="card mb-4 shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="fas fa-calendar-alt fa-icon"></i> تقرير امتحانات الطالب</h4>
                <div>
                    <button class="btn btn-light btn-sm" onclick="toggleAllExams()">
                        <i class="fas fa-expand-alt fa-icon"></i> توسيع/طي الكل
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th width="5%">#</th>

                                <th width="10%">المادة</th>
                                <th width="10%">الصف</th>
                                <th width="10%">التاريخ</th>
                                <th width="10%">الوقت الرسمي</th>
                                <th width="10%">بداية الطالب</th>
                                <th width="10%">نهاية الطالب</th>
                                <th width="8%">المدة</th>
                                <th width="7%">الحالة</th>
                                <th width="15%">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int examCounter = 1; }
                            @foreach (var exam in studentExamsReport)
                            {
                                <tr>
                                    <td>@examCounter</td>
                                  

                                    <td>@exam.SubjectName</td>
                                    <td>@exam.ClassName</td>
                                    <td>@exam.ExamDateFormatted</td>
                                    <td>
                                        <span class="badge bg-info">@exam.OfficialTime</span>
                                    </td>
                                    <td>
                                        @if (exam.StudentStartTime.HasValue)
                                        {
                                            <span class="status-active">
                                                @exam.StudentStartTime.Value.ToString("hh:mm tt")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-inactive">لم يبدأ</span>
                                        }
                                    </td>
                                    <td>
                                        @if (exam.StudentEndTime.HasValue)
                                        {
                                            <span class="status-finished">
                                                @exam.StudentEndTime.Value.ToString("hh:mm tt")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pending">مستمر</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="duration-badge">@exam.Duration</span>
                                    </td>
                                    <td>
                                        @if (exam.ExamStatus == "منتهي")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle fa-icon"></i> @exam.ExamStatus
                                            </span>
                                        }
                                        else if (exam.ExamStatus == "نشط")
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fas fa-play-circle fa-icon"></i> @exam.ExamStatus
                                            </span>
                                        }
                                        else if (exam.ExamStatus == "لم يبدأ")
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-clock fa-icon"></i> @exam.ExamStatus
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">
                                                <i class="fas fa-info-circle fa-icon"></i> @exam.ExamStatus
                                            </span>
                                        }
                                    </td>
                                    <td class="action-buttons">
                                        <div class="exam-actions">
                                            @if (exam.ExamStatus != "منتهي" && exam.IsActive)
                                            {
                                                <button class="btn btn-success btn-sm open-exam-btn"
                                                        data-exam-id="@exam.ExamID"
                                                        data-student-number="@exam.StudentNumber">
                                                    <i class="fas fa-unlock fa-icon"></i> فتح
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-secondary btn-sm" disabled>
                                                    <i class="fas fa-lock fa-icon"></i> مغلق
                                                </button>
                                            }

                                            <button class="btn btn-info btn-sm view-details-btn"
                                                    data-exam-id="@exam.ExamID"
                                                    onclick="viewExamDetails(@exam.ExamID)">
                                                <i class="fas fa-eye fa-icon"></i> عرض
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                examCounter++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col-md-3 col-sm-6">
                        <strong>الإجمالي:</strong>
                        <span class="badge bg-primary">@studentExamsReport.Count امتحان</span>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <strong>منتهية:</strong>
                        <span class="badge bg-success">@studentExamsReport.Count(e => e.ExamStatus == "منتهي")</span>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <strong>نشطة:</strong>
                        <span class="badge bg-warning">@studentExamsReport.Count(e => e.ExamStatus == "نشط")</span>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <strong>لم تبدأ:</strong>
                        <span class="badge bg-secondary">@studentExamsReport.Count(e => e.ExamStatus == "لم يبدأ")</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- تقرير الأسئلة غير المجابة -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            <h4><i class="fas fa-exclamation-triangle fa-icon"></i> لا توجد نتائج</h4>
            <p>لم يتم العثور على أسئلة غير مجابة للبحث المحدد.</p>
        </div>
    }
    else
    {
        // تجميع حسب الطالب
        var students = Model.GroupBy(r => r.StudentNumber);

        foreach (var studentGroup in students)
        {
            var firstRecord = studentGroup.First();
            <div class="card mb-4 shadow student-card">
                <!-- زر تعديل بيانات الطالب داخل كارت الطالب -->
                <div class="student-actions">
                    <button type="button" class="btn btn-outline-info btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#editStudentModal"
                            data-student-number="@firstRecord.StudentNumber"
                            onclick="loadStudentData(@firstRecord.StudentNumber)">
                        <i class="fas fa-user-edit fa-icon"></i> تعديل بيانات
                    </button>

                </div>

                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="student-avatar me-3">
                            <i class="fas fa-user-graduate fa-2x"></i>
                        </div>
                        <div>
                            <h4 class="mb-0">
                                @firstRecord.StudentName
                                <small class="text-light">(@firstRecord.UserName)</small>
                            </h4>
                            <small>
                                <i class="fas fa-id-card fa-icon"></i>
                                الرقم: @firstRecord.StudentNumber
                            </small>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-light text-dark">
                            <i class="fas fa-exclamation-circle fa-icon"></i>
                            @studentGroup.Count() سؤال غير مجاب
                        </span>
                    </div>
                </div>

                <div class="card-body">
                    <!-- معلومات الطالب -->
                    <div class="row mb-4">
                        <div class="col-md-3 col-sm-6 mb-2">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    <h6 class="card-title text-muted">
                                        <i class="fas fa-graduation-cap fa-icon"></i> الصف
                                    </h6>
                                    <p class="card-text">
                                        <span class="badge bg-info">@firstRecord.ClassName</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-2">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    <h6 class="card-title text-muted">
                                        <i class="fas fa-flag fa-icon"></i> البلد
                                    </h6>
                                    <p class="card-text">@firstRecord.CountryName</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-2">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    <h6 class="card-title text-muted">
                                        <i class="fas fa-file-alt fa-icon"></i> الامتحانات
                                    </h6>
                                    <p class="card-text">
                                        @studentGroup.GroupBy(r => r.ExamID).Count() امتحان
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-2">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    <h6 class="card-title text-muted">
                                        <i class="fas fa-chart-line fa-icon"></i> النسبة
                                    </h6>
                                    <p class="card-text">
                                        @{
                                            var totalQuestions = studentGroup.Sum(q => q.TotalQuestions);
                                            var answeredQuestions = totalQuestions - studentGroup.Count();
                                            var percentage = totalQuestions > 0 ? (answeredQuestions * 100.0 / totalQuestions) : 0;
                                        }
                                        <span class="badge @(percentage >= 70 ? "bg-success" : percentage >= 50 ? "bg-warning" : "bg-danger")">
                                            @percentage.ToString("0.00")%
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- تجميع حسب الامتحان -->
                    @{
                        var examGroups = studentGroup.GroupBy(r => r.ExamID);
                        int totalStudentExams = examGroups.Count();
                        int totalStudentUnanswered = studentGroup.Count();
                        float totalLostDegree = studentGroup.Sum(q => (float)q.QuestionDegree);
                    }

                    <h5 class="mb-3">
                        <i class="fas fa-list-alt fa-icon"></i> الامتحانات
                        <small class="text-muted">(@totalStudentExams امتحان)</small>
                    </h5>

                    <div class="accordion" id="accordionStudent-@firstRecord.StudentNumber">
                        @foreach (var examGroup in examGroups)
                        {
                            var examFirst = examGroup.First();
                            <div class="card mb-3">
                                <div class="card-header d-flex justify-content-between align-items-center"
                                     id="heading-@examFirst.ExamID"
                                     style="background-color: #f8f9fa;">
                                    <div class="d-flex align-items-center">
                                        <button class="btn btn-link text-decoration-none text-dark me-3"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#collapse-@examFirst.ExamID"
                                                aria-expanded="true"
                                                aria-controls="collapse-@examFirst.ExamID">
                                            <i class="fas fa-chevron-down fa-icon"></i>
                                        </button>
                                        <div>
                                            <h6 class="mb-0">
                                                <i class="fas fa-file-alt fa-icon text-primary"></i>
                                                @examFirst.ExamName
                                            </h6>
                                            <small class="text-muted">
                                                @examFirst.SubjectName -
                                                <i class="fas fa-calendar fa-icon"></i>
                                                @examFirst.ExamDate?.ToString("yyyy/MM/dd")
                                            </small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            <span class="badge @(examFirst.UnansweredCount > 0 ? "bg-danger" : "bg-success")">
                                                @examFirst.UnansweredCount / @examFirst.TotalQuestions
                                            </span>
                                        </div>
                                        <div>
                                            <button class="btn btn-success btn-sm open-exam-btn"
                                                    data-exam-id="@examFirst.ExamID"
                                                    data-student-number="@firstRecord.StudentNumber">
                                                <i class="fas fa-unlock fa-icon"></i> فتح
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div id="collapse-@examFirst.ExamID" class="collapse show"
                                     aria-labelledby="heading-@examFirst.ExamID">
                                    <div class="card-body">
                                        <!-- إحصائيات الامتحان -->
                                        <div class="row mb-4">
                                            <div class="col-xl-3 col-md-6 mb-3">
                                                <div class="card border-primary">
                                                    <div class="card-body text-center">
                                                        <h6 class="card-title text-primary">
                                                            <i class="fas fa-question-circle fa-icon"></i> إجمالي الأسئلة
                                                        </h6>
                                                        <h2 class="text-primary">@examFirst.TotalQuestions</h2>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-3 col-md-6 mb-3">
                                                <div class="card border-success">
                                                    <div class="card-body text-center">
                                                        <h6 class="card-title text-success">
                                                            <i class="fas fa-check-circle fa-icon"></i> أسئلة مجابة
                                                        </h6>
                                                        <h2 class="text-success">@examFirst.AnsweredCount</h2>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-3 col-md-6 mb-3">
                                                <div class="card border-danger">
                                                    <div class="card-body text-center">
                                                        <h6 class="card-title text-danger">
                                                            <i class="fas fa-times-circle fa-icon"></i> أسئلة غير مجابة
                                                        </h6>
                                                        <h2 class="text-danger">@examFirst.UnansweredCount</h2>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <!-- جدول الأسئلة غير المجابة -->
                                        @if (examFirst.UnansweredCount > 0)
                                        {
                                            <div class="alert alert-info d-flex align-items-center">
                                                <i class="fas fa-info-circle fa-2x me-3"></i>
                                                <div>
                                                    <h6 class="alert-heading">أسئلة غير مجابة</h6>
                                                    <p class="mb-0">تم العثور على @examFirst.UnansweredCount سؤال غير مجاب في هذا الامتحان</p>
                                                </div>
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-bordered table-hover table-striped">
                                                    <thead class="table-dark">
                                                        <tr>
                                                            <th width="5%">#</th>
                                                            <th width="10%">رقم السؤال</th>
                                                            <th width="15%">نوع السؤال</th>

                                                            <th width="45%">نص السؤال</th>
                                                            <th width="15%">الحالة</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{ int counter = 1; }
                                                        @foreach (var question in examGroup)
                                                        {
                                                            <tr>
                                                                <td>@(counter++)</td>
                                                                <td>
                                                                    <span class="badge bg-secondary">@question.QuestionsID</span>
                                                                </td>
                                                                <td>
                                                                    <span class="badge @(question.QuestionType == 1 ? "bg-primary" : "bg-info")">
                                                                        <i class="fas @(question.QuestionType == 1 ? "fa-list" : "fa-pen") fa-icon"></i>
                                                                        @question.QuestionTypeText
                                                                    </span>
                                                                </td>

                                                                @functions {
                                                                    public string DisplayQuestion(string text)
                                                                    {
                                                                        if (string.IsNullOrEmpty(text))
                                                                            return "";

                                                                        // تحقق إن النص Base64
                                                                        string base64Pattern = @"^[a-zA-Z0-9\+/]*={0,2}$";
                                                                        if (text.Length % 4 != 0 || !System.Text.RegularExpressions.Regex.IsMatch(text, base64Pattern))
                                                                        {
                                                                            return text; // النص مش Base64، اعرضه كما هو
                                                                        }

                                                                        // النص يبدو Base64، نفك تشفيره
                                                                        return ((Lesson.Areas.Student.Controllers.StudentReportController)this.ViewContext.Controller).Decrypt(text);
                                                                    }
                                                                }

                                                                @{
                                                                    // أولاً نفك التشفير ونحول النص لـ string عادي
                                                                    string fullText = DisplayQuestion(question.QuestionTitle) ?? "لا يوجد نص";

                                                                    // بعدين نعمل الاختصار لو النص طويل
                                                                    string shortTitle = fullText.Length > 100 ? fullText.Substring(0, 100) + "..." : fullText;
                                                                }

                                                                <td>
                                                                    <div class="question-title" data-full-title="@fullText">
                                                                        @Html.Raw(HttpUtility.HtmlDecode(shortTitle))
                                                                        @if (fullText.Length > 100)
                                                                        {
                                                                            <br />
                                                                            <a href="#" class="text-info see-more" onclick="showFullText(this)">
                                                                                <i class="fas fa-external-link-alt fa-icon"></i> عرض النص الكامل
                                                                            </a>
                                                                        }
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    @if (question.IsExamFinished)
                                                                    {
                                                                        <span class="badge bg-danger">
                                                                            <i class="fas fa-lock fa-icon"></i> انتهى
                                                                        </span>
                                                                    }
                                                                    else if (question.EndAt.HasValue)
                                                                    {
                                                                        <span class="badge bg-warning">
                                                                            <i class="fas fa-clock fa-icon"></i> نشط
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-secondary">
                                                                            <i class="fas fa-question fa-icon"></i> غير محدد
                                                                        </span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-success text-center">
                                                <i class="fas fa-check-circle fa-3x mb-3"></i>
                                                <h5>لا توجد أسئلة غير مجابة في هذا الامتحان</h5>
                                                <p>تم الإجابة على جميع الأسئلة بنجاح</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-footer text-muted d-flex justify-content-between align-items-center">
                    <div>
                        <strong>ملخص الطالب:</strong>
                        <span class="badge bg-secondary">
                            <i class="fas fa-file-alt fa-icon"></i> @totalStudentExams امتحان
                        </span>
                        <span class="badge bg-danger">
                            <i class="fas fa-question-circle fa-icon"></i> @totalStudentUnanswered سؤال غير مجاب
                        </span>

                    </div>

                </div>
            </div>
        }
    }
</div>

<!-- Modal مع Scroll -->
