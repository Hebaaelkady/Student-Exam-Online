@model List<Lesson.Models.SupportTicketPageVM>
@{
    ViewBag.Title = "تقرير الأسئلة غير المجابة";
    Layout = "~/Areas/Student/Views/Shared/_LayoutAdmin.cshtml";
}
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>

<h2 class="mb-4">📩 Open Support Tickets</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6">
            <div class="card shadow-sm mb-4 border-left-warning">
                <div class="card-body">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <h5 class="mb-0 font-weight-bold text-primary">
                                @item.StudentName
                            </h5>
                            <small class="text-muted">
                                @item.SubjectName
                            </small>
                        </div>

                        @{
                            string ticketText = "";
                            string badgeClass = "badge-secondary";

                            switch (item.TicketType)
                            {
                                case "Not open":
                                    ticketText = "لم يتم فتح الامتحان";
                                    badgeClass = "badge-danger";
                                    break;

                                case "Question":
                                    ticketText = "السؤال لا يظهر";
                                    badgeClass = "badge-warning";
                                    break;

                                case "Time":
                                    ticketText = "انتهى الوقت فجأة";
                                    badgeClass = "badge-info";
                                    break;

                                case "Other":
                                    ticketText = "أخرى";
                                    badgeClass = "badge-secondary";
                                    break;
                            }
                        }

                        <span class="badge @badgeClass px-3 py-2">
                            @ticketText
                        </span>
                    </div>

                    <!-- Description -->
                    <div class="bg-light p-3 rounded mt-3">
                        <p class="mb-0 text-dark">
                            @item.Description
                        </p>
                    </div>

                    <!-- Actions -->
                    <div class="text-end mt-3">
                        <button class="btn btn-outline-primary btn-sm"
                                data-toggle="modal"
                                data-target="#ticketModal"
                                data-ticketid="@item.TicketId"
                                data-student="@item.StudentName"
                                data-email="@item.Email"
                                data-phone="@item.PhoneNumber"
                                data-nationalid="@item.NationalId"
                                data-studentnumber="@item.StudentNumber"
                                data-institutetype="@item.InstituteType"
                                data-mazhab="@item.Mazhab"
                                data-institutename="@item.InstituteName"
                                data-country="@item.Country"
                                data-section="@item.Section">
                            ⚙️ إدارة الطلب
                        </button> <form method="post"
                                        action="@Url.Action("ArchiveTicket","StudentReport")"
                                        onsubmit="return confirm('هل أنت متأكد من إرسال الطلب إلى الأرشيف؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId" value="@item.TicketId" />

                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                🗄️ إرسال للأرشيف
                            </button>
                        </form>
                    </div>

                </div>

            </div>
        </div>
    }
</div>
<div class="modal fade" id="ticketModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">إدارة طلب الدعم</h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    &times;
                </button>
            </div>

            @using (Html.BeginForm("TicketAction", "StudentReport"))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ticketId" id="ticketId" />

                <div class="modal-body">

                    <label>الاسم</label>
                    <input name="studentName" id="studentName" class="form-control mb-2" />

                    <label>الرقم القومي</label>
                    <input name="nationalId" id="nationalId" class="form-control mb-2" />

                    <label>رقم الجلوس</label>
                    <input name="studentNumber" id="studentNumber" class="form-control mb-2" />

                    <label>نوع المعهد</label>
                    @Html.DropDownList(
                        "instituteType",
                        (IEnumerable<SelectListItem>)ViewBag.InstTypes,
                        "-- اختر نوع المعهد --",
                        new { @class = "form-control mb-2", @id = "instituteType" }
                    )

                    <label>المذهب</label>
                    @Html.DropDownList(
                        "mazhab",
                        (IEnumerable<SelectListItem>)ViewBag.Mazhabs,
                        "-- اختر المذهب --",
                        new { @class = "form-control mb-2", @id = "mazhab" }
                    )


                    <label>المعهد</label>
                    <input name="instituteName" id="instituteName" class="form-control mb-2" />

                    <label>الدولة</label>
                    <input name="country" id="country" class="form-control mb-2" />

                    <label>الشعبة</label>

                    @Html.DropDownList(
"Sho3baID",
(IEnumerable<SelectListItem>)ViewBag.Sho3baID,
"-- اختر المذهب --",
new { @class = "form-control mb-2", @id = "section" }
)

                    <hr />

                    <label>نقل لمجموعة أخرى</label>
                    @Html.DropDownList(
    "newGroupId",
    (IEnumerable<SelectListItem>)ViewBag.Groups,
    "اختر مجموعة",
    new { @class = "form-control mb-3" }
)


                </div>

                <div class="modal-footer">

                    <button name="actionType" value="OpenExam"
                            class="btn btn-success">
                        فتح الامتحان
                    </button>

                    <button name="actionType" value="ChangeGroup"
                            class="btn btn-warning">
                        نقل المجموعة
                    </button>

                    <button name="actionType" value="EditStudent"
                            class="btn btn-primary">
                        حفظ التعديلات
                    </button>

                </div>
            }
        </div>
    </div>
</div>
<script>
    
        $('#ticketModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); 
            $('#ticketId').val(button.data('ticketid'));
            $('#studentName').val(button.data('student'));
            $('#email').val(button.data('email'));
            $('#phone').val(button.data('phone'));
            $('#nationalId').val(button.data('nationalid'));
            $('#studentNumber').val(button.data('studentnumber'));
            $('#instituteType').val(button.data('institutetype'));
            $('#mazhab').val(button.data('mazhab'));
            $('#instituteName').val(button.data('institutename'));
            $('#country').val(button.data('country'));
            $('#section').val(button.data('section'));
         

    });
</script>
